<html>
  <head></head>
  <body>
    <div class="navbar">
      <ul>
        <a href="">About</a>
        <a href="/listings">Marketplace</a>
        <a href="/devs">Developers</a>
      </ul>
    </div>
    <div class="devs">
      <h1>All Developers</h1>
      <a href="/devs/new">Add Developer</a>
      <% for (let i = 0; i < devs.length; i++) { %>
      <div>
        <h2><%= devs[i].name %></h2>
        <h3><%= devs[i].website %></h3>
        <a href="/devs/<%=devs[i].id%>">open</a>
      </div>
      <% } %>
    </div>
  </body>
</html>
