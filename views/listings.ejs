<html>
  <head></head>
  <body>
    <div class="navbar">
      <ul>
        <a href="">About</a>
        <a href="/listings">Marketplace</a>
        <a href="/devs">Developers</a>
      </ul>
    </div>
    <div class="listings">
      <h1>All listings</h1>
      <a href="/listings?category=b2b">B2B</a>
      <a href="/listings?category=b2c">B2C</a>
      <a href="/listings/new">Create new listing</a>
      <% for (let i = 0; i < listings.length; i++) { %>
        <div>
          <h1><%= listings[i].title %></h1>
          <p><%= listings[i].description %></p>
          <p>Price: $<%= listings[i].price %></p>
          <p>Clicks: <%= listings[i].clicks %></p>
          <p>Date Posted: <%= listings[i].date_posted %></p>
          <a href="/listings/<%= listings[i].id %>">Open Listing</a>
        </div>
      <% } %>
      
  </body>
</html>
